# Copy to .env and fill in. Never commit real values.
#
# Values marked "dev default" are safe only for the local Docker Compose stack (infra/docker). The
# API and worker must refuse to start outside NODE_ENV=development with these values (threat model
# SEC-004). Docker Compose reads this file through `--env-file .env` (see `pnpm dev:infra`); the base
# Compose file has no defaults for credentials and refuses to start without it.

# --- App ---
# NODE_ENV here applies to apps run directly on the host (`pnpm dev`). The Compose files set their own:
# production in infra/docker/docker-compose.yml, development in docker-compose.dev.yml.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
APP_TIMEZONE=America/Sao_Paulo
# api listener (T-008). API_HOST defaults to 127.0.0.1 outside production and 0.0.0.0 in production.
API_PORT=3001

# --- Database (PostgreSQL 17; `postgres` service in infra/docker) ---
# POSTGRES_* configure the container; DATABASE_URL must use the same user, password and database.
# Inside Compose the host is `postgres`; from the host machine it is `localhost:${POSTGRES_PORT}`.
POSTGRES_USER=linkedin_ops
# dev default:
POSTGRES_PASSWORD=linkedin_ops_dev
POSTGRES_DB=linkedin_ops
POSTGRES_PORT=5432
DATABASE_URL=postgresql://linkedin_ops:linkedin_ops_dev@localhost:5432/linkedin_ops

# --- Auth / session ---
# >= 32 bytes. `change-me*` placeholders are accepted in NODE_ENV=development only (SEC-004).
SESSION_SECRET=change-me-generate-a-long-random-string
# base64 of exactly 32 random bytes (`openssl rand -base64 32`). In development the placeholder leaves token
# encryption unconfigured; outside development the key is mandatory. Key ring (ADR-0004 item 3) alternative:
#   ENCRYPTION_KEYS=1:<base64>,2:<base64>   ENCRYPTION_ACTIVE_KEY_VERSION=2   (never together with ENCRYPTION_KEY)
ENCRYPTION_KEY=change-me-32-bytes-base64-for-token-at-rest-encryption
# Reverse proxies whose X-Forwarded-For is trusted for the client IP (login rate limit per IP, audit). Empty =
# trust none: the socket address is the client IP. Comma-separated IPs/CIDRs of YOUR proxy only (e.g. the
# Docker network of the shared Caddy, `172.18.0.0/16`); never `private_ranges`/`true` (any client could forge
# its IP). Validated at boot (T-015).
TRUSTED_PROXY_CIDRS=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- LinkedIn (official API, OAuth 2.0) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/auth/linkedin/callback
# ADR-0007 N3: required | disabled, no default. Enforced by T-038; validated as a slot since T-008.
LINKEDIN_PKCE=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# --- Object storage (S3-compatible; `s3` service in infra/docker, OCI Object Storage in prod) ---
# In dev the same key pair is the root credential of the local object-storage server and the
# credential the api/worker use. Inside Compose the endpoint is `http://s3:9000`.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=linkedin-ops
# dev defaults:
S3_ACCESS_KEY_ID=linkedin_ops_dev
S3_SECRET_ACCESS_KEY=linkedin_ops_dev_secret
S3_FORCE_PATH_STYLE=true
S3_PORT=9000

# --- Docker Compose ---
# Tag applied to the locally built api/web/worker images (infra/docker).
IMAGE_TAG=dev

# --- Caddy (reverse proxy; infra/caddy/Caddyfile) ---
# Dev: localhost with Caddy's internal CA. Production (T-056) sets the public host, an ACME e-mail and
# CADDY_BIND_ADDRESS=0.0.0.0.
CADDY_SITE_ADDRESS=localhost
CADDY_TLS=internal
CADDY_BIND_ADDRESS=127.0.0.1
CADDY_HSTS_MAX_AGE=0

# --- Observability ---
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
