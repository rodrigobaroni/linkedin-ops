# Copy to .env and fill in. Never commit real values.

# --- App ---
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
APP_TIMEZONE=America/Sao_Paulo

# --- Database ---
DATABASE_URL=postgresql://linkedin_ops:change-me@localhost:5432/linkedin_ops

# --- Auth / session ---
SESSION_SECRET=change-me-generate-a-long-random-string
ENCRYPTION_KEY=change-me-32-bytes-base64-for-token-at-rest-encryption

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- LinkedIn (official API, OAuth 2.0) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/auth/linkedin/callback

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# --- Object storage (S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=linkedin-ops
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Observability ---
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
