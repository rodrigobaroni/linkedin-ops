# LinkedIn Ops — Caddy reverse proxy (T-003 local; T-056 production reuses this file via env vars).
#
# Same origin for browser and API (system-overview: no CORS in production):
#   /api/*  -> api:3001      everything else -> web:3000
#
# Env (see .env.example):
#   CADDY_SITE_ADDRESS  localhost (dev) | your.public.host (prod)
#   CADDY_TLS           internal (dev: Caddy's local CA, self-signed) | ops@example.com (prod: ACME e-mail)
#   CADDY_HSTS_MAX_AGE  0 (dev; keeps http://localhost:<port> usable) | 31536000 (prod)
# Threat model TM-18: host allowlist = the site address; only 80/443 are published; the admin API stays
# on the container loopback (used by the Compose healthcheck); X-Forwarded-* are set by reverse_proxy.
# Caddy is the edge: no `trusted_proxies`, so the client IP is the TCP peer and X-Forwarded-For sent by
# clients is ignored (PR #80 review, Sentinela 4). If a load balancer or CDN is ever put in front,
# declare its exact CIDRs with `trusted_proxies static <cidr>...` plus `trusted_proxies_strict`; never
# `private_ranges`.

{
	admin 127.0.0.1:2019
}

{$CADDY_SITE_ADDRESS:localhost} {
	tls {$CADDY_TLS:internal}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age={$CADDY_HSTS_MAX_AGE:0}; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
		-X-Powered-By
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		# The access log must never retain OAuth or session material (PR #80 review, Sentinela 1): the
		# LinkedIn callback arrives as /auth/linkedin/callback?code=…&state=…. Caddy already drops the
		# Cookie/Authorization/Set-Cookie headers; the query filter removes the sensitive parameters
		# from request>uri. The CI job compose-smoke proves it with a synthetic ?code=&state= request.
		format filter {
			wrap json
			fields {
				request>uri query {
					delete code
					delete state
					delete token
					delete access_token
					delete refresh_token
					delete id_token
				}
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}
