{
  "name": "@linkedin-ops/api",
  "version": "0.0.0",
  "private": true,
  "description": "REST API (NestJS, OpenAPI) \u2014 HTTP adapters over the domain layer",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "setup:user": "tsx --env-file-if-exists=../../.env src/cli/setup-user.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "rm -rf dist .turbo coverage *.tsbuildinfo",
    "linkedin:probe": "tsx --env-file-if-exists=../../.env scripts/linkedin-probe.ts"
  },
  "dependencies": {
    "@fastify/cookie": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/multipart": "catalog:",
    "@fastify/static": "catalog:",
    "@linkedin-ops/contracts": "workspace:*",
    "@linkedin-ops/domain": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "fastify": "catalog:",
    "jose": "catalog:",
    "nestjs-pino": "catalog:",
    "pg-boss": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "swagger-ui-dist": "catalog:",
    "unpdf": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@linkedin-ops/config": "workspace:*",
    "@nestjs/testing": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "eslint": "catalog:",
    "pino-pretty": "catalog:",
    "supertest": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
