{
  "name": "@linkedin-ops/web",
  "version": "0.0.0",
  "private": true,
  "description": "Dashboard (Next.js App Router) — presentation only, no secrets, no database access",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .next .turbo coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@linkedin-ops/contracts": "workspace:*"
  },
  "devDependencies": {
    "@linkedin-ops/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
