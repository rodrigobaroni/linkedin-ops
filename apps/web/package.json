{
  "name": "@linkedin-ops/web",
  "version": "0.0.0",
  "private": true,
  "description": "Dashboard (Next.js App Router) — presentation only, no secrets, no database access",
  "type": "module",
  "scripts": {
    "dev": "API_PROXY=1 next dev",
    "dev:mock": "msw init public --no-save && NEXT_PUBLIC_API_MOCK=1 next dev",
    "build": "next build && node scripts/assert-no-mocks-in-bundle.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .next .turbo coverage next-env.d.ts public/mockServiceWorker.js *.tsbuildinfo"
  },
  "dependencies": {
    "@hookform/resolvers": "catalog:",
    "@linkedin-ops/contracts": "workspace:*",
    "@linkedin-ops/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.5",
    "lucide-react": "^1.61.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@linkedin-ops/config": "workspace:*",
    "@next/eslint-plugin-next": "^16.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "catalog:",
    "jsdom": "^30.1.2",
    "msw": "catalog:",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
