// LinkedIn Ops — Prisma schema (T-005). Source of truth for the model: docs/architecture/data-model.md.
//
// Conventions (data-model.md "Convenções"):
// - Tables/columns are snake_case in PostgreSQL (`@@map`/`@map`), camelCase in Prisma/TypeScript.
// - Primary keys are uuid v7 generated by the application (`src/ids.ts`); no database default.
// - Every timestamp is `timestamptz`; local time only exists next to an IANA `timezone` column.
// - Every domain entity carries `user_id` (owner) so `AuthorizationService.scope()` applies to every
//   repository (ADR-0007 §12, invariant I14). Join tables are not entities and carry no owner.
// - Enums mirror `packages/contracts` (`z.enum`) value by value; where the contract exposes lowercase
//   values (briefing §13: `candidate`, `code-card`, `pt-BR`) the Prisma name is SCREAMING_SNAKE and the
//   database value is `@map`ped to the contract value. `test/enums-parity.test.ts` enforces it.
// - What Prisma cannot express lives in hand-written SQL inside the migration (clearly marked block):
//   `CREATE EXTENSION citext`, partial unique indexes (I7, I8, active voice profile), CHECK constraints
//   (I5, untrusted flag) and the append-only triggers on draft_versions, approvals and audit_events (I3, I11).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums (packages/contracts/src/enums) ─────────────────────────────

enum UserRole {
  OWNER
  EDITOR
  VIEWER

  @@map("user_role")
}

/// Database-only (no contract counterpart): the API exposes `LinkedInIntegrationStatus` instead.
enum OAuthProvider {
  LINKEDIN

  @@map("oauth_provider")
}

/// Database-only lifecycle of a stored credential (ADR-0004 §11). `DISCONNECTED` in the API = no row.
enum TokenStatus {
  ACTIVE
  EXPIRED
  REVOKED
  REAUTH_REQUIRED

  @@map("token_status")
}

enum AutonomyMode {
  ASSISTED
  AUTOPILOT_CONTROLLED
  AUTOPILOT_FULL

  @@map("autonomy_mode")
}

/// Contract values are BCP 47 tags, so the database stores the mapped value (`pt-BR`, `en`).
enum Language {
  PT_BR @map("pt-BR")
  EN    @map("en")

  @@map("language")
}

enum StoryBankEntryStatus {
  ACTIVE
  ARCHIVED

  @@map("story_bank_entry_status")
}

enum SourceType {
  RSS
  ATOM
  URL_LIST

  @@map("source_type")
}

enum TrustLevel {
  LOW
  MEDIUM
  HIGH

  @@map("trust_level")
}

enum SourceFetchStatus {
  OK
  FAILED
  BLOCKED

  @@map("source_fetch_status")
}

enum CurationRunTrigger {
  CRON
  MANUAL

  @@map("curation_run_trigger")
}

enum CurationRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED

  @@map("curation_run_status")
}

enum OpportunityOrigin {
  CURATION
  MANUAL

  @@map("opportunity_origin")
}

/// Briefing §13 exposes these in lowercase; the database stores the contract value.
enum OpportunityStatus {
  CANDIDATE @map("candidate")
  SELECTED  @map("selected")
  DISMISSED @map("dismissed")
  EXPIRED   @map("expired")

  @@map("opportunity_status")
}

/// Briefing §13 `suggestedFormat`; the database stores the contract value (`code-card`).
enum SuggestedFormat {
  TEXT      @map("text")
  CODE_CARD @map("code-card")
  IMAGE     @map("image")
  CAROUSEL  @map("carousel")

  @@map("suggested_format")
}

enum DraftStatus {
  GENERATING
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  DISCARDED

  @@map("draft_status")
}

enum DraftVersionAuthorType {
  SYSTEM
  USER

  @@map("draft_version_author_type")
}

enum ApprovalDecision {
  APPROVED
  REJECTED

  @@map("approval_decision")
}

/// Who decided or requested something inside the editorial pipeline (contracts `ActorType`).
enum ActorType {
  USER
  SYSTEM

  @@map("actor_type")
}

/// Audit actor adds WORKER for job handlers acting on their own schedule (contracts `AuditActorType`).
enum AuditActorType {
  USER
  SYSTEM
  WORKER

  @@map("audit_actor_type")
}

enum ScheduleStatus {
  PENDING
  DISPATCHED
  CANCELLED

  @@map("schedule_status")
}

enum PublicationStatus {
  PENDING
  IN_PROGRESS
  SUCCEEDED
  FAILED
  AMBIGUOUS

  @@map("publication_status")
}

enum MediaOrigin {
  UPLOAD
  RENDERED

  @@map("media_origin")
}

enum MediaKind {
  IMAGE
  CODE_CARD
  DOCUMENT

  @@map("media_kind")
}

enum LinkedInUploadStatus {
  NONE
  UPLOADED
  FAILED

  @@map("linkedin_upload_status")
}

enum MediaAssetStatus {
  READY
  FAILED
  DELETED

  @@map("media_asset_status")
}

enum NotificationChannel {
  TELEGRAM
  IN_APP

  @@map("notification_channel")
}

enum NotificationKind {
  CURATION_READY
  DRAFT_READY
  DRAFT_PREFETCHED
  APPROVAL_NEEDED
  AUTOPILOT_WILL_PUBLISH
  AUTOPILOT_PUBLISHED
  AUTOPILOT_REVOKED
  PUBLISHED
  PUBLICATION_FAILED
  PUBLICATION_AMBIGUOUS
  TOKEN_EXPIRING
  REAUTH_REQUIRED
  RUN_FAILED

  @@map("notification_kind")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ

  @@map("notification_status")
}

// ───────────────────────────── 2.1 Identity and access ─────────────────────────────

model User {
  id                   String   @id @db.Uuid
  /// Login e-mail; `citext` makes the unique index case-insensitive (extension created in the migration).
  email                String   @unique @db.Citext
  /// Argon2id (ADR-0007). Never leaves the database.
  passwordHash         String   @map("password_hash")
  name                 String
  role                 UserRole @default(OWNER)
  locale               String   @default("pt-BR")
  /// IANA timezone used to display and to propose slots.
  timezone             String   @default("America/Sao_Paulo")
  /// `urn:li:person:...`, filled when the LinkedIn OAuth connection is made.
  linkedinMemberUrn    String?  @map("linkedin_member_urn")
  /// Reserved for TOTP (ADR-0007 §4). Same envelope as OAuthToken (ADR-0004): ciphertext, wrapped DEK
  /// and KEK version are all null or all set (`CHECK` in the migration). Encryption itself: T-052.
  totpSecretCiphertext Bytes?   @map("totp_secret_ciphertext")
  totpWrappedDek       Bytes?   @map("totp_wrapped_dek")
  totpKeyVersion       String?  @map("totp_key_version")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions         Session[]
  oauthStates      OAuthState[]
  oauthTokens      OAuthToken[]
  autonomySettings AutonomySettings?
  voiceProfiles    VoiceProfile[]
  storyBankEntries StoryBankEntry[]
  contentPillars   ContentPillar[]
  sources          Source[]
  sourceItems      SourceItem[]
  watchlists       Watchlist[]
  curationRuns     CurationRun[]
  opportunities    Opportunity[]
  drafts           Draft[]
  draftVersions    DraftVersion[]
  approvals        Approval[]
  approvalsAsActor Approval[]        @relation("ApprovalActor")
  schedules        Schedule[]
  publications     Publication[]
  mediaAssets      MediaAsset[]
  notifications    Notification[]
  auditEvents      AuditEvent[]
  idempotencyKeys  IdempotencyKey[]

  @@map("users")
}

/// Server-side session (ADR-0007 §2). `id` is the public identifier shown in `GET /auth/sessions`;
/// the cookie carries a 256-bit opaque secret of which only the SHA-256 hash is stored.
model Session {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// SHA-256 (hex) of the opaque cookie value. The secret itself is never persisted.
  secretHash    String    @unique @map("secret_hash")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// End of the elevated window after `POST /auth/reauth` (15 min); null = not elevated.
  elevatedUntil DateTime? @map("elevated_until") @db.Timestamptz(3)
  /// Minimized per docs/security/data-and-lgpd.md (truncated/hashed IP policy applied by the API).
  ip            String?
  userAgent     String?   @map("user_agent")
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthStates OAuthState[]

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Transient OAuth `state` (ADR-0007 N1, oauth-and-tokens.md §2.1). Only hashes are stored; the row is
/// claimed atomically (`used_at`) before any call to LinkedIn and purged after expiry.
model OAuthState {
  id                     String        @id @db.Uuid
  userId                 String        @map("user_id") @db.Uuid
  sessionId              String        @map("session_id") @db.Uuid
  provider               OAuthProvider @default(LINKEDIN)
  /// HMAC/SHA-256 of the `state` value.
  stateHash              String        @unique @map("state_hash")
  /// SHA-256 of the OIDC `nonce`, when `openid` is requested.
  nonceHash              String?       @map("nonce_hash")
  /// PKCE `code_verifier`, encrypted at rest (ADR-0004 framing); null when PKCE is disabled.
  /// Set together with `code_verifier_key_version` (`CHECK` all-or-none in the migration); rows live at
  /// most 10 minutes (`expires_at`, indexed) and are purged by the retention job (T-052 inherits this).
  codeVerifierCiphertext Bytes?        @map("code_verifier_ciphertext")
  codeVerifierKeyVersion String?       @map("code_verifier_key_version")
  scopes                 String[]
  /// Allowlisted logical UI route to return to (enum-like, never a raw URL).
  returnTo               String?       @map("return_to")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  /// At most 10 minutes after creation.
  expiresAt              DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt                 DateTime?     @map("used_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("oauth_states")
}

/// OAuth credential, encrypted at rest with envelope encryption (ADR-0004). No plaintext column exists;
/// the API never serializes `*_ciphertext` or `wrapped_dek`. Encryption itself lands in T-052.
model OAuthToken {
  id                     String        @id @db.Uuid
  userId                 String        @map("user_id") @db.Uuid
  provider               OAuthProvider @default(LINKEDIN)
  /// `sub` / member URN at the provider.
  providerSubject        String        @map("provider_subject")
  /// AES-256-GCM: schemaVersion(1) || nonce(12) || ciphertext || tag(16).
  accessTokenCiphertext  Bytes         @map("access_token_ciphertext")
  /// LinkedIn only issues refresh tokens for some products; may be null.
  refreshTokenCiphertext Bytes?        @map("refresh_token_ciphertext")
  /// DEK wrapped with the active KEK, same authenticated framing (ADR-0004 §1).
  wrappedDek             Bytes         @map("wrapped_dek")
  /// KEK version used to wrap the DEK (rotation, ADR-0004 §8).
  keyVersion             String        @map("key_version")
  scopes                 String[]
  accessExpiresAt        DateTime      @map("access_expires_at") @db.Timestamptz(3)
  refreshExpiresAt       DateTime?     @map("refresh_expires_at") @db.Timestamptz(3)
  status                 TokenStatus   @default(ACTIVE)
  lastRefreshedAt        DateTime?     @map("last_refreshed_at") @db.Timestamptz(3)
  lastUsedAt             DateTime?     @map("last_used_at") @db.Timestamptz(3)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("oauth_tokens")
}

/// 1:1 with User (data-model.md §2.1). Every change produces an AuditEvent.
model AutonomySettings {
  userId                String       @id @map("user_id") @db.Uuid
  mode                  AutonomyMode @default(ASSISTED)
  /// Only in autopilot modes.
  autoApproveMinScore   Decimal?     @map("auto_approve_min_score") @db.Decimal(5, 2)
  /// Pillars the autopilot may act on; empty = none.
  allowedPillarIds      String[]     @map("allowed_pillar_ids") @db.Uuid
  maxAutoPostsPerWeek   Int          @default(3) @map("max_auto_posts_per_week")
  /// AUTOPILOT_CONTROLLED: minutes between notification and publish.
  cancelWindowMinutes   Int          @default(60) @map("cancel_window_minutes")
  /// ASSISTED only: pre-generate a draft for the best eligible candidate (one, never five).
  assistedPrefetchDraft Boolean      @default(false) @map("assisted_prefetch_draft")
  /// Media is only published with human approval; applies to every mode.
  mediaRequiresHuman    Boolean      @default(true) @map("media_requires_human")
  /// `{ start: "22:00", end: "07:00", timezone }` — `QuietHoursSchema`.
  quietHours            Json?        @map("quiet_hours")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("autonomy_settings")
}

// ───────────────────────────── 2.2 Editorial memory ─────────────────────────────

/// Versioned voice profile. Changing = new version; immutable once used by a DraftVersion.
/// At most one active version per user: partial unique index `(user_id) WHERE is_active` (migration).
model VoiceProfile {
  id            String   @id @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  version       Int
  /// Activation is an explicit service step (deactivate the previous version in the same transaction).
  isActive      Boolean  @default(false) @map("is_active")
  language      Language @default(PT_BR)
  tone          String
  /// What to do.
  principles    String[]
  /// What to avoid.
  avoid         String[]
  bannedPhrases String[] @map("banned_phrases")
  /// `VoiceVocabularyEntry[]`.
  vocabulary    Json     @default("[]")
  /// `VoiceProfileExample[]` — real excerpts approved by Rodrigo; never invented.
  examples      Json     @default("[]")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  drafts Draft[]

  @@unique([userId, version])
  @@map("voice_profiles")
}

/// First-person stories provided by Rodrigo. The system never creates entries.
model StoryBankEntry {
  id         String               @id @db.Uuid
  userId     String               @map("user_id") @db.Uuid
  title      String
  narrative  String
  context    String?
  lesson     String?
  /// `StoryFact[]`: `[{ claim, value, sourceUrl, verifiedAt }]`.
  facts      Json                 @default("[]")
  tags       String[]
  pillarIds  String[]             @map("pillar_ids") @db.Uuid
  usageCount Int                  @default(0) @map("usage_count")
  lastUsedAt DateTime?            @map("last_used_at") @db.Timestamptz(3)
  status     StoryBankEntryStatus @default(ACTIVE)
  deletedAt  DateTime?            @map("deleted_at") @db.Timestamptz(3)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  draftVersions DraftVersionStoryEntry[]

  @@index([userId, status])
  @@map("story_bank_entries")
}

model ContentPillar {
  id             String    @id @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  slug           String
  name           String
  description    String?
  targetAudience String?   @map("target_audience")
  /// Ranking priority (0–10).
  weight         Decimal   @default(1) @db.Decimal(4, 2)
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  watchlists    Watchlist[]

  @@unique([userId, slug])
  @@map("content_pillars")
}

// ───────────────────────────── 2.3 Sources and collection (untrusted data) ─────────────────────────────

model Source {
  id                   String             @id @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  type                 SourceType
  name                 String
  /// https only; host allowlist and private-IP rejection are enforced by the API.
  url                  String
  /// Normalized `url` (lowercase host, no tracking params, no fragment); unique per user (T-005 AC).
  canonicalUrl         String             @map("canonical_url")
  trustLevel           TrustLevel         @default(MEDIUM) @map("trust_level")
  pillarHints          String[]           @map("pillar_hints") @db.Uuid
  /// Minimum 60.
  fetchIntervalMinutes Int                @default(360) @map("fetch_interval_minutes")
  isActive             Boolean            @default(true) @map("is_active")
  etag                 String?
  lastModified         String?            @map("last_modified")
  lastFetchedAt        DateTime?          @map("last_fetched_at") @db.Timestamptz(3)
  lastStatus           SourceFetchStatus? @map("last_status")
  /// Classified, secret-free.
  lastError            String?            @map("last_error")
  deletedAt            DateTime?          @map("deleted_at") @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      SourceItem[]
  watchlists WatchlistSource[]

  @@unique([userId, canonicalUrl])
  @@map("sources")
}

/// Keyword filter over collected items. It never monitors LinkedIn.
model Watchlist {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  keywords  String[]
  pillarId  String?  @map("pillar_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pillar  ContentPillar?    @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  sources WatchlistSource[]

  @@index([userId])
  @@map("watchlists")
}

/// Optional source filter of a watchlist; no rows = all active sources.
model WatchlistSource {
  watchlistId String @map("watchlist_id") @db.Uuid
  sourceId    String @map("source_id") @db.Uuid

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  source    Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([watchlistId, sourceId])
  @@map("watchlist_sources")
}

/// Collected external content. ALWAYS untrusted: never an instruction, only delimited `input` (ADR-0005).
/// Raw HTML is never stored. Retention: 90 days (data-and-lgpd.md §4), then only hash + canonical URL.
model SourceItem {
  id           String    @id @db.Uuid
  sourceId     String    @map("source_id") @db.Uuid
  /// Denormalized owner (= source.user_id) so scoping and retention never need a join.
  userId       String    @map("user_id") @db.Uuid
  /// Feed guid or URL hash; unique per source.
  externalId   String    @map("external_id")
  canonicalUrl String    @map("canonical_url")
  /// Sanitized plain text, bounded length.
  title        String
  author       String?
  /// HTML → text, bounded (SOURCE_ITEM_MAX_CONTENT_CHARS).
  contentText  String    @map("content_text")
  /// sha256 (hex) of the normalized text; dedupe index.
  contentHash  String    @map("content_hash")
  language     String?
  /// From the feed; `fetched_at` is ours.
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(3)
  fetchedAt    DateTime  @default(now()) @map("fetched_at") @db.Timestamptz(3)
  /// Constant reminder for every consumer; `CHECK (untrusted)` in the migration.
  untrusted    Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  source        Source                   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunities OpportunitySourceItem[]
  draftVersions DraftVersionSourceItem[]

  @@unique([sourceId, externalId])
  @@index([userId, contentHash])
  @@index([sourceId, publishedAt])
  @@index([fetchedAt])
  @@map("source_items")
}

// ───────────────────────────── 2.4 Curation and opportunities ─────────────────────────────

/// One curation execution (cron Mon/Wed/Fri 09:00 America/Sao_Paulo, or manual).
/// I13 (cron idempotency): unique `(user_id, scheduled_for, trigger)` — `trigger` added in T-005 so a
/// MANUAL run never collides with the CRON run of the same instant.
model CurationRun {
  id            String             @id @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  scheduledFor  DateTime           @map("scheduled_for") @db.Timestamptz(3)
  timezone      String             @default("America/Sao_Paulo")
  trigger       CurationRunTrigger
  status        CurationRunStatus  @default(QUEUED)
  startedAt     DateTime?          @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime?          @map("finished_at") @db.Timestamptz(3)
  /// `CurationRunStats`.
  stats         Json?
  engineVersion String?            @map("engine_version")
  promptId      String?            @map("prompt_id")
  promptVersion String?            @map("prompt_version")
  model         String?
  /// `ClassifiedError`, secret-free.
  error         Json?
  /// pg-boss job id.
  jobId         String?            @map("job_id")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([userId, scheduledFor, trigger])
  @@index([userId, status])
  @@map("curation_runs")
}

/// Briefing §13 contract plus internal fields. DISMISSED/EXPIRED rows are never deleted.
model Opportunity {
  id              String            @id @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  /// Null when `origin = MANUAL`.
  curationRunId   String?           @map("curation_run_id") @db.Uuid
  origin          OpportunityOrigin @default(CURATION)
  title           String
  summary         String
  /// Recency of the source content.
  publishedAt     DateTime?         @map("published_at") @db.Timestamptz(3)
  contentPillarId String            @map("content_pillar_id") @db.Uuid
  targetAudience  String            @map("target_audience")
  relevanceReason String            @map("relevance_reason")
  suggestedAngle  String            @map("suggested_angle")
  suggestedFormat SuggestedFormat   @map("suggested_format")
  /// 0–100.
  score           Decimal           @db.Decimal(5, 2)
  /// `ScoreBreakdown`: recency, pillarFit, audienceFit, novelty, sourceTrust, voiceFit, risk.
  scoreBreakdown  Json              @map("score_breakdown")
  /// 1–5 inside the run; unique per run (I1).
  rank            Int?
  status          OpportunityStatus @default(CANDIDATE)
  selectedAt      DateTime?         @map("selected_at") @db.Timestamptz(3)
  dismissedAt     DateTime?         @map("dismissed_at") @db.Timestamptz(3)
  /// Default: next scheduled run (Q8).
  expiresAt       DateTime?         @map("expires_at") @db.Timestamptz(3)
  dismissReason   String?           @map("dismiss_reason")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  curationRun   CurationRun?            @relation(fields: [curationRunId], references: [id], onDelete: Restrict)
  contentPillar ContentPillar           @relation(fields: [contentPillarId], references: [id], onDelete: Restrict)
  sourceItems   OpportunitySourceItem[]
  draft         Draft?

  @@unique([curationRunId, rank])
  @@index([userId, status])
  @@index([userId, expiresAt])
  @@map("opportunities")
}

/// Briefing §13 `sourceIds`.
model OpportunitySourceItem {
  opportunityId String @map("opportunity_id") @db.Uuid
  sourceItemId  String @map("source_item_id") @db.Uuid
  position      Int    @default(0)

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  sourceItem  SourceItem  @relation(fields: [sourceItemId], references: [id], onDelete: Restrict)

  @@id([opportunityId, sourceItemId])
  @@map("opportunity_source_items")
}

// ───────────────────────────── 2.5 Drafts and versions ─────────────────────────────

/// Lifecycle aggregate from GENERATING onwards (data-model.md §3). Only `ContentStateMachine.transition()`
/// writes `status`. `row_version` backs optimistic locking (`expectedRowVersion`).
model Draft {
  id                  String      @id @db.Uuid
  userId              String      @map("user_id") @db.Uuid
  /// I2: Opportunity ↔ Draft is 1:0..1.
  opportunityId       String      @unique @map("opportunity_id") @db.Uuid
  /// Voice version used.
  voiceProfileId      String      @map("voice_profile_id") @db.Uuid
  status              DraftStatus @default(GENERATING)
  /// Latest version (edited or generated); always the highest `version_number`.
  currentVersionId    String?     @unique @map("current_version_id") @db.Uuid
  /// Version that may be published; cleared by any edit (I4).
  approvedVersionId   String?     @unique @map("approved_version_id") @db.Uuid
  language            Language    @default(PT_BR)
  rowVersion          Int         @default(1) @map("row_version")
  /// `ClassifiedError` when FAILED.
  failureReason       Json?       @map("failure_reason")
  /// True when the last Publication ended AMBIGUOUS (ADR-0003); blocks retry until reconciled.
  needsReconciliation Boolean     @default(false) @map("needs_reconciliation")
  /// Generated by `assisted_prefetch_draft` before human selection; false once adopted.
  isPrefetch          Boolean     @default(false) @map("is_prefetch")
  /// `{ localDateTime, timezone }` suggested by the system; NOT a Schedule.
  proposedSlot        Json?       @map("proposed_slot")
  discardedAt         DateTime?   @map("discarded_at") @db.Timestamptz(3)
  discardReason       String?     @map("discard_reason")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity     Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  voiceProfile    VoiceProfile   @relation(fields: [voiceProfileId], references: [id], onDelete: Restrict)
  currentVersion  DraftVersion?  @relation("DraftCurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  approvedVersion DraftVersion?  @relation("DraftApprovedVersion", fields: [approvedVersionId], references: [id], onDelete: Restrict)
  versions        DraftVersion[] @relation("DraftVersions")
  approvals       Approval[]
  schedules       Schedule[]
  publications    Publication[]

  @@index([userId, status])
  @@map("drafts")
}

/// Immutable (I3): regenerating/editing creates a new row; UPDATE/DELETE are rejected by trigger.
model DraftVersion {
  id              String                 @id @db.Uuid
  draftId         String                 @map("draft_id") @db.Uuid
  /// Denormalized owner (= draft.user_id).
  userId          String                 @map("user_id") @db.Uuid
  versionNumber   Int                    @map("version_number")
  parentVersionId String?                @map("parent_version_id") @db.Uuid
  /// Regenerate = SYSTEM; edit = USER.
  authorType      DraftVersionAuthorType @map("author_type")
  /// Full post text.
  body            String
  /// `Hook[]`: `{ text, formula, rationale }`.
  hooks           Json                   @default("[]")
  /// `DraftMediaSuggestion`; `altText` mandatory when not null.
  mediaSuggestion Json?                  @map("media_suggestion")
  /// `Citation[]` (plus the `draft_version_source_items` join).
  citations       Json                   @default("[]")
  /// `GenerationMetadata`, only for SYSTEM versions.
  generation      Json?
  /// `DraftEval` rubric results.
  eval            Json?
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  draft         Draft                    @relation("DraftVersions", fields: [draftId], references: [id], onDelete: Restrict)
  user          User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  parentVersion DraftVersion?            @relation("DraftVersionParent", fields: [parentVersionId], references: [id], onDelete: Restrict)
  childVersions DraftVersion[]           @relation("DraftVersionParent")
  currentOf     Draft?                   @relation("DraftCurrentVersion")
  approvedOf    Draft?                   @relation("DraftApprovedVersion")
  sourceItems   DraftVersionSourceItem[]
  storyEntries  DraftVersionStoryEntry[]
  mediaAssets   DraftVersionMediaAsset[]
  approvals     Approval[]
  schedules     Schedule[]
  publications  Publication[]

  @@unique([draftId, versionNumber])
  @@map("draft_versions")
}

model DraftVersionSourceItem {
  draftVersionId String @map("draft_version_id") @db.Uuid
  sourceItemId   String @map("source_item_id") @db.Uuid

  draftVersion DraftVersion @relation(fields: [draftVersionId], references: [id], onDelete: Restrict)
  sourceItem   SourceItem   @relation(fields: [sourceItemId], references: [id], onDelete: Restrict)

  @@id([draftVersionId, sourceItemId])
  @@map("draft_version_source_items")
}

/// Story Bank entries used by a version.
model DraftVersionStoryEntry {
  draftVersionId String @map("draft_version_id") @db.Uuid
  storyEntryId   String @map("story_entry_id") @db.Uuid

  draftVersion DraftVersion   @relation(fields: [draftVersionId], references: [id], onDelete: Restrict)
  storyEntry   StoryBankEntry @relation(fields: [storyEntryId], references: [id], onDelete: Restrict)

  @@id([draftVersionId, storyEntryId])
  @@map("draft_version_story_entries")
}

model DraftVersionMediaAsset {
  draftVersionId String @map("draft_version_id") @db.Uuid
  mediaAssetId   String @map("media_asset_id") @db.Uuid
  position       Int    @default(0)

  draftVersion DraftVersion @relation(fields: [draftVersionId], references: [id], onDelete: Restrict)
  mediaAsset   MediaAsset   @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@id([draftVersionId, mediaAssetId])
  @@map("draft_version_media_assets")
}

// ───────────────────────────── 2.6 Approval, schedule, publication ─────────────────────────────

/// Immutable, one row per decision, always about one specific version. Append-only by trigger.
/// I5: `CHECK (actor_type <> 'SYSTEM' OR (reason IS NOT NULL AND policy_snapshot IS NOT NULL))`;
/// USER decisions require `actor_user_id` (both CHECKs live in the migration).
model Approval {
  id             String           @id @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  draftId        String           @map("draft_id") @db.Uuid
  draftVersionId String           @map("draft_version_id") @db.Uuid
  decision       ApprovalDecision
  actorType      ActorType        @map("actor_type")
  /// Required when `actor_type = USER`.
  actorUserId    String?          @map("actor_user_id") @db.Uuid
  /// Mode in force at decision time.
  autonomyMode   AutonomyMode     @map("autonomy_mode")
  /// Mandatory when `actor_type = SYSTEM` (policy, score, pillar).
  reason         String?
  /// Copy of AutonomySettings when SYSTEM.
  policySnapshot Json?            @map("policy_snapshot")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  draft        Draft        @relation(fields: [draftId], references: [id], onDelete: Restrict)
  draftVersion DraftVersion @relation(fields: [draftVersionId], references: [id], onDelete: Restrict)
  actorUser    User?        @relation("ApprovalActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([draftId, createdAt])
  @@map("approvals")
}

/// I6: `scheduled_at` (UTC instant) and `timezone` (IANA) are NOT NULL and always persisted together.
/// I7: at most one PENDING schedule per draft — partial unique index in the migration.
model Schedule {
  id                 String         @id @db.Uuid
  userId             String         @map("user_id") @db.Uuid
  draftId            String         @map("draft_id") @db.Uuid
  /// Version approved at scheduling time.
  draftVersionId     String         @map("draft_version_id") @db.Uuid
  /// Computed UTC instant.
  scheduledAt        DateTime       @map("scheduled_at") @db.Timestamptz(3)
  /// IANA timezone, e.g. `America/Sao_Paulo`. Mandatory.
  timezone           String
  /// What the user typed (`2026-10-15T09:00`), kept for audit and DST.
  requestedLocalTime String         @map("requested_local_time")
  status             ScheduleStatus @default(PENDING)
  /// pg-boss job id.
  jobId              String?        @map("job_id")
  createdByType      ActorType      @map("created_by_type")
  cancelledAt        DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  cancelReason       String?        @map("cancel_reason")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  draft        Draft         @relation(fields: [draftId], references: [id], onDelete: Restrict)
  draftVersion DraftVersion  @relation(fields: [draftVersionId], references: [id], onDelete: Restrict)
  publications Publication[]

  @@index([userId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("schedules")
}

/// One attempt to publish a version (ADR-0003). I8: unique `idempotency_key` plus partial unique
/// `(draft_id) WHERE status IN ('IN_PROGRESS','SUCCEEDED','AMBIGUOUS')` (migration): an ambiguous
/// outcome also blocks a second post until reconciled (ADR-0003). I9: claim is a conditional UPDATE.
model Publication {
  id                 String            @id @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  /// Null only for a manual "publish now" of free text (MVP-0, T-039): then `body` holds the text.
  draftId            String?           @map("draft_id") @db.Uuid
  /// Set together with `draft_id` (`CHECK` in migration 20261021210000_manual_publications).
  draftVersionId     String?           @map("draft_version_id") @db.Uuid
  /// Exact text of a manual publication (1..3000 chars); null when it comes from a draft version.
  body               String?
  /// Null = "publish now".
  scheduleId         String?           @map("schedule_id") @db.Uuid
  /// `pub:<draftId>:<draftVersionId>:<scheduleId | manual:<Idempotency-Key>>[:retry:<n>]`; manual text
  /// (no draft): `pub:manual:<userId>:<Idempotency-Key>`.
  idempotencyKey     String            @unique @map("idempotency_key")
  status             PublicationStatus @default(PENDING)
  attempt            Int               @default(0)
  /// sha256 of the exact payload sent to LinkedIn; set before the call (reconciliation).
  requestFingerprint String?           @map("request_fingerprint")
  /// `urn:li:share:...` / `urn:li:ugcPost:...`.
  externalPostId     String?           @map("external_post_id")
  externalUrl        String?           @map("external_url")
  startedAt          DateTime?         @map("started_at") @db.Timestamptz(3)
  finishedAt         DateTime?         @map("finished_at") @db.Timestamptz(3)
  publishedAt        DateTime?         @map("published_at") @db.Timestamptz(3)
  /// `PublicationError { code, httpStatus, message }`, never the token.
  error              Json?
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  draft        Draft?        @relation(fields: [draftId], references: [id], onDelete: Restrict)
  draftVersion DraftVersion? @relation(fields: [draftVersionId], references: [id], onDelete: Restrict)
  schedule     Schedule?     @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@index([draftId, createdAt])
  @@index([status, startedAt])
  @@map("publications")
}

// ───────────────────────────── 2.7 Media, notifications, audit ─────────────────────────────

/// Stored media (S3-compatible). Bucket and key stay internal; access goes through signed URLs.
model MediaAsset {
  id                   String               @id @db.Uuid
  userId               String               @map("user_id") @db.Uuid
  origin               MediaOrigin
  kind                 MediaKind
  bucket               String
  storageKey           String               @map("storage_key")
  mimeType             String               @map("mime_type")
  bytes                Int
  sha256               String
  width                Int?
  height               Int?
  /// `CodeCardRenderSpec` for rendered code cards.
  renderSpec           Json?                @map("render_spec")
  /// After upload through the LinkedIn Images API.
  linkedinAssetUrn     String?              @map("linkedin_asset_urn")
  linkedinUploadStatus LinkedInUploadStatus @default(NONE) @map("linkedin_upload_status")
  status               MediaAssetStatus     @default(READY)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  draftVersions DraftVersionMediaAsset[]

  @@unique([bucket, storageKey])
  @@index([userId, status])
  @@map("media_assets")
}

/// Outbound notification (Telegram only notifies; it never approves or publishes).
model Notification {
  id        String              @id @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel
  kind      NotificationKind
  /// `NotificationPayload`: ids + short text, never secrets.
  payload   Json
  dedupeKey String              @unique @map("dedupe_key")
  status    NotificationStatus  @default(PENDING)
  sentAt    DateTime?           @map("sent_at") @db.Timestamptz(3)
  readAt    DateTime?           @map("read_at") @db.Timestamptz(3)
  error     String?
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@map("notifications")
}

/// Append-only audit trail (I11): INSERT only; UPDATE/DELETE rejected by trigger (and, later, by the
/// runtime role's privileges — ADR-0004 §9). `before`/`after` are redacted diffs, never tokens.
model AuditEvent {
  id            String         @id @db.Uuid
  /// Owner of the resource; null for system-wide events.
  userId        String?        @map("user_id") @db.Uuid
  actorType     AuditActorType @map("actor_type")
  /// User id or job name.
  actorId       String?        @map("actor_id")
  /// Dotted action name: `draft.approve`, `publication.succeeded`, `settings.autonomy.update`.
  action        String
  entityType    String         @map("entity_type")
  entityId      String?        @map("entity_id") @db.Uuid
  before        Json?
  after         Json?
  /// Request id or job id.
  correlationId String         @map("correlation_id")
  /// Only for user actions; minimized per LGPD policy.
  ip            String?
  userAgent     String?        @map("user_agent")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@index([correlationId])
  @@map("audit_events")
}

/// `Idempotency-Key` replay store (contracts.md §1): scoped by user and route, kept 24 h. The row is
/// reserved in the same transaction as the effect; same key + different body → 409.
model IdempotencyKey {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  /// Route id from the contracts registry (e.g. `drafts.publish`).
  route            String
  key              String    @db.Uuid
  /// sha256 (hex) of the canonical request body.
  requestHash      String    @map("request_hash")
  responseStatus   Int?      @map("response_status")
  responseBody     Json?     @map("response_body")
  responseLocation String?   @map("response_location")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(3)
  /// created_at + 24 h; purged by a retention job.
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, route, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
