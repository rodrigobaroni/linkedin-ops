{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": ["eslint/*.js", "prettier/*.js", "vitest/*.js", "eslint.config.js"],
  "exclude": ["node_modules"]
}
