{
  "name": "@linkedin-ops/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint, Prettier and Vitest configuration for the LinkedIn Ops monorepo",
  "type": "module",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.library.json": "./tsconfig.library.json",
    "./tsconfig.app.json": "./tsconfig.app.json",
    "./eslint": "./eslint/base.js",
    "./prettier": "./prettier/index.js",
    "./vitest": "./vitest/base.js",
    "./eslint/react": "./eslint/react.js"
  },
  "files": [
    "tsconfig.*.json",
    "eslint",
    "prettier",
    "vitest"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "echo \"@linkedin-ops/config: no tests\"",
    "build": "echo \"@linkedin-ops/config: nothing to build\"",
    "clean": "rm -rf .turbo"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2"
  },
  "devDependencies": {
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": ">=5.9 <6",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
