{
  "name": "linkedin-ops",
  "version": "0.0.0",
  "private": true,
  "description": "LinkedIn Ops — self-hosted platform to operate the editorial strategy of a LinkedIn profile",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules/.cache .turbo",
    "compose": "docker compose --env-file .env -f infra/docker/docker-compose.yml",
    "compose:dev": "docker compose --env-file .env -f infra/docker/docker-compose.yml -f infra/docker/docker-compose.dev.yml",
    "dev:infra": "pnpm run compose up -d --wait postgres s3 && pnpm run compose run --rm s3-init",
    "dev:infra:down": "pnpm run compose down",
    "dev:infra:logs": "pnpm run compose logs -f postgres s3",
    "dev:stack": "pnpm run compose:dev up --build",
    "dev:stack:down": "pnpm run compose:dev down",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@linkedin-ops/config": "workspace:*",
    "husky": "^9.1.7",
    "prettier": "catalog:",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  },
  "prettier": "@linkedin-ops/config/prettier"
}
